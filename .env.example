# Django Configuration
DJANGO_SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration
DB_NAME=torgovo
DB_USER=postgres
DB_PASSWORD=db_password
DB_HOST=localhost
DB_PORT=5432

# Redis Configuration
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ACCESS_TOKEN_LIFETIME=900
JWT_REFRESH_TOKEN_LIFETIME=604800

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_SECRET_KEY=your-google-oauth-secret-key

# SMS Service (Twilio)
TWILIO_ACCOUNT_SID=your-twilio-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_PHONE_NUMBER=+1234567890

# Encryption Key for API Keys (32 bytes)
FERNET_KEY=your-32-byte-encryption-key-123456789012

# Frontend URL
FRONTEND_URL=https://torgovo.com
BASE_URL=https://api.yourdomain.com
# Public site origin (referral links etc.) — frontend is also on torgovo.vercel.app
SITE_URL=https://torgovo.com

# Email Configuration
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=noreply@yourdomain.com

# Exchange Configuration (Optional Admin Keys)
BINANCE_API_KEY=your-binance-api-key
BINANCE_SECRET_KEY=your-binance-secret-key
BYBIT_API_KEY=your-bybit-api-key
BYBIT_SECRET_KEY=your-bybit-secret-key

# File Upload Configuration
AWS_ACCESS_KEY_ID=your-aws-access-key
AWS_SECRET_ACCESS_KEY=your-aws-secret-key
AWS_STORAGE_BUCKET_NAME=torgovo-uploads

# Security Settings
SECURE_SSL_REDIRECT=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True

# CORS Configuration
CORS_ALLOWED_ORIGINS=https://torgovo.com,https://torgovo.vercel.app
CORS_ALLOW_ALL_ORIGINS=False

# Logging Configuration
SENTRY_DSN=your-sentry-dsn-for-error-tracking

# Trading Bot Configuration
MAX_STRATEGY_ERRORS=10
EXCHANGE_CONFIG_RATE_LIMIT_DEFAULT=1200
EXCHANGE_CONFIG_RATE_LIMIT_PREMIUM=6000
EXCHANGE_CONFIG_MAX_RETRIES=3
EXCHANGE_CONFIG_RETRY_DELAY=1

# Bot Configuration
BOT_CONFIG_MAX_BOTS_FREE_USER=3
BOT_CONFIG_MAX_BOTS_PREMIUM_USER=15
BOT_CONFIG_MAX_BOTS_ENTERPRISE_USER=50
BOT_CONFIG_MIN_TRADE_AMOUNT=1.0
BOT_CONFIG_MAX_TRADE_AMOUNT=100000.0

# Quantum AI Configuration
QUANTUM_AI_CONFIG_MIN_DEPOSIT_AMOUNT=100.0
QUANTUM_AI_CONFIG_MAX_DEPOSIT_AMOUNT=1000000.0

# Performance Monitoring
PROMETHEUS_METRICS_ENABLED=True
DJANGO_DEBUG_TOOLBAR=False

# Backup (item #6)
BACKUP_STORAGE_DIR=/app/backups
